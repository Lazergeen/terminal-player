#!/usr/bin/env python3
import curses
import math
import os
import random
import shutil
import signal
import subprocess
import time
from dataclasses import dataclass
from pathlib import Path


MUSIC_DIR = Path.home() / "Music"
SUPPORTED_EXTS = {
    ".mp3",
    ".flac",
    ".wav",
    ".ogg",
    ".m4a",
    ".aac",
    ".opus",
    ".wma",
    ".aiff",
    ".alac",
}

EDIT_MENU = "edit"
RENAME_MODE = "rename"
DELETE_CONFIRM = "delete_confirm"
MODE_MENU = "mode_menu"
ANIMATION_MENU = "animation_menu"
NORMAL_MODE = "normal"
MIX_MODE = "mix"
PULSE_ANIMATION = "pulse"
WAVE_ANIMATION = "wave"
RAIN_ANIMATION = "rain"
ANIMATIONS = (PULSE_ANIMATION, WAVE_ANIMATION, RAIN_ANIMATION)
SHUFFLER = random.SystemRandom()


@dataclass
class Track:
    path: Path
    title: str
    duration: float | None = None


class AudioBackend:
    def __init__(self) -> None:
        self.process: subprocess.Popen | None = None
        self.started_at = 0.0
        self.paused_at: float | None = None
        self.paused_total = 0.0
        self.track: Track | None = None
        self.backend = self._find_backend()

    def _find_backend(self) -> str | None:
        for name in ("ffplay", "mpv", "vlc", "cvlc", "mpg123", "play"):
            if shutil.which(name):
                return name
        return None

    def play(self, track: Track) -> None:
        self.stop()
        if self.backend is None:
            return

        cmd = self._command_for(track.path)
        self.process = subprocess.Popen(
            cmd,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        self.track = track
        self.started_at = time.monotonic()
        self.paused_at = None
        self.paused_total = 0.0

    def _command_for(self, path: Path) -> list[str]:
        assert self.backend is not None
        file_name = str(path)
        if self.backend == "ffplay":
            return ["ffplay", "-nodisp", "-autoexit", "-loglevel", "quiet", file_name]
        if self.backend == "mpv":
            return ["mpv", "--no-video", "--really-quiet", file_name]
        if self.backend in ("vlc", "cvlc"):
            return [self.backend, "--intf", "dummy", "--play-and-exit", file_name]
        if self.backend == "mpg123":
            return ["mpg123", "-q", file_name]
        return ["play", "-q", file_name]

    def stop(self) -> None:
        if self.process and self.process.poll() is None:
            try:
                os.killpg(self.process.pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
            try:
                self.process.wait(timeout=0.8)
            except subprocess.TimeoutExpired:
                try:
                    os.killpg(self.process.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
        self.process = None
        self.track = None
        self.paused_at = None
        self.paused_total = 0.0

    def toggle_pause(self) -> None:
        if not self.process or self.process.poll() is not None:
            return
        if self.paused_at is None:
            try:
                os.killpg(self.process.pid, signal.SIGSTOP)
                self.paused_at = time.monotonic()
            except ProcessLookupError:
                pass
        else:
            try:
                os.killpg(self.process.pid, signal.SIGCONT)
                self.paused_total += time.monotonic() - self.paused_at
                self.paused_at = None
            except ProcessLookupError:
                pass

    def is_playing(self) -> bool:
        return bool(self.process and self.process.poll() is None)

    def finished(self) -> bool:
        return bool(self.process and self.process.poll() is not None)

    def elapsed(self) -> float:
        if not self.process:
            return 0.0
        frozen = self.paused_at if self.paused_at is not None else time.monotonic()
        return max(0.0, frozen - self.started_at - self.paused_total)


class Visualizer:
    def __init__(self) -> None:
        self.particles: list[dict[str, float]] = []
        self.phase = 0.0
        self.bars: list[float] = []

    def reseed(self, track: Track | None) -> None:
        seed = str(track.path if track else time.time())
        random.seed(seed)
        self.particles.clear()
        self.phase = 0.0
        self.bars = [random.random() for _ in range(40)]

    def draw(
        self,
        win: curses.window,
        top: int,
        left: int,
        height: int,
        width: int,
        active: bool,
        animation: str,
    ) -> None:
        if height < 8 or width < 20:
            return

        self.phase += 0.11 if active else 0.035
        beat = (math.sin(self.phase * 2.1) + math.sin(self.phase * 5.4) * 0.45 + 1.35) / 2.8
        energy = beat if active else 0.16

        if animation == WAVE_ANIMATION:
            self._draw_wave(win, top, left, height, width, energy)
            return
        if animation == RAIN_ANIMATION:
            self._draw_rain(win, top, left, height, width, energy, active)
            return

        spawn = 3 + int(energy * 8) if active else 1
        cx = left + width // 2
        cy = top + height // 2
        for _ in range(spawn):
            angle = random.random() * math.tau
            speed = 0.22 + random.random() * (0.8 + energy)
            self.particles.append(
                {
                    "x": float(cx),
                    "y": float(cy),
                    "vx": math.cos(angle) * speed * 1.9,
                    "vy": math.sin(angle) * speed * 0.8,
                    "life": 1.0,
                    "kind": random.randrange(3),
                }
            )

        next_particles = []
        for p in self.particles[-360:]:
            p["x"] += p["vx"]
            p["y"] += p["vy"]
            p["vy"] += math.sin(self.phase + p["x"] * 0.03) * 0.012
            p["life"] -= 0.025 + (0.015 if active else 0.025)
            if p["life"] > 0 and left < p["x"] < left + width - 1 and top < p["y"] < top + height - 1:
                next_particles.append(p)
        self.particles = next_particles

        chars = ("*", "+", ".", "o", "@")
        for i, p in enumerate(self.particles):
            y = int(p["y"])
            x = int(p["x"])
            if top <= y < top + height and left <= x < left + width:
                color = 3 + (i % 4)
                char = chars[min(len(chars) - 1, int((p["life"] + energy) * 2.2))]
                safe_add(win, y, x, char, curses.color_pair(color) | curses.A_BOLD)

        ring_count = 3
        for ring in range(ring_count):
            radius = 2.4 + ring * 3.4 + energy * 4 + (self.phase * (ring + 1.2)) % 5
            points = max(18, int(radius * 7))
            for n in range(points):
                angle = n / points * math.tau
                wobble = math.sin(angle * 5 + self.phase * 2) * energy
                x = int(cx + math.cos(angle) * (radius + wobble) * 1.7)
                y = int(cy + math.sin(angle) * (radius + wobble) * 0.72)
                if top <= y < top + height and left <= x < left + width:
                    safe_add(win, y, x, ".", curses.color_pair(5 + ring % 2))

        bar_width = min(width - 4, 52)
        base_y = top + height - 3
        start_x = left + max(1, (width - bar_width) // 2)
        if len(self.bars) != bar_width:
            self.bars = [random.random() for _ in range(bar_width)]
        for i in range(bar_width):
            target = (math.sin(self.phase * 3 + i * 0.37) + 1) / 2
            target = max(target, random.random() * energy)
            self.bars[i] = self.bars[i] * 0.72 + target * 0.28
            h = int(1 + self.bars[i] * energy * min(7, height // 3))
            for j in range(h):
                safe_add(win, base_y - j, start_x + i, "▇", curses.color_pair(6) | curses.A_BOLD)

    def _draw_wave(self, win: curses.window, top: int, left: int, height: int, width: int, energy: float) -> None:
        mid = top + height // 2
        layers = (
            ("~", 1.0, curses.color_pair(4) | curses.A_BOLD),
            ("=", 0.62, curses.color_pair(5)),
            (".", 0.34, curses.color_pair(6)),
        )
        for char, scale, attr in layers:
            amplitude = max(2, int(height * 0.24 * energy * scale))
            for x_offset in range(1, width - 1):
                phase = self.phase * (2.0 + scale) + x_offset * 0.18
                y = mid + int(math.sin(phase) * amplitude + math.sin(phase * 0.43) * amplitude * 0.45)
                if top <= y < top + height:
                    safe_add(win, y, left + x_offset, char, attr)

        meter_width = min(width - 4, 58)
        meter_x = left + max(1, (width - meter_width) // 2)
        floor_y = top + height - 3
        for i in range(meter_width):
            pulse = (math.sin(self.phase * 4 + i * 0.31) + 1) / 2
            height_here = int(1 + pulse * energy * min(8, height // 3))
            for row in range(height_here):
                safe_add(win, floor_y - row, meter_x + i, "▆", curses.color_pair(3 + row % 4) | curses.A_BOLD)

    def _draw_rain(
        self,
        win: curses.window,
        top: int,
        left: int,
        height: int,
        width: int,
        energy: float,
        active: bool,
    ) -> None:
        spawn = 5 + int(energy * 14) if active else 2
        for _ in range(spawn):
            self.particles.append(
                {
                    "x": float(left + random.randrange(1, max(2, width - 1))),
                    "y": float(top + 1),
                    "vx": math.sin(self.phase + random.random()) * 0.12,
                    "vy": 0.35 + random.random() * (0.95 + energy),
                    "life": 1.0,
                    "kind": random.randrange(4),
                }
            )

        drops = []
        chars = ("|", ":", "!", "*")
        for p in self.particles[-420:]:
            p["x"] += p["vx"]
            p["y"] += p["vy"]
            p["life"] -= 0.012
            if p["life"] > 0 and p["y"] < top + height - 2:
                drops.append(p)
        self.particles = drops

        for idx, p in enumerate(self.particles):
            x = int(p["x"])
            y = int(p["y"])
            if top <= y < top + height and left <= x < left + width:
                safe_add(win, y, x, chars[int(p["kind"])], curses.color_pair(3 + idx % 4) | curses.A_BOLD)

        splash_y = top + height - 3
        for x_offset in range(2, width - 2, 2):
            if random.random() < energy * 0.32:
                safe_add(win, splash_y, left + x_offset, "_", curses.color_pair(6) | curses.A_BOLD)


def scan_music() -> list[Track]:
    if not MUSIC_DIR.exists():
        return []
    tracks = [
        Track(path=path, title=path.stem)
        for path in MUSIC_DIR.rglob("*")
        if path.is_file() and path.suffix.lower() in SUPPORTED_EXTS
    ]
    tracks.sort(key=lambda track: str(track.path).casefold())
    return tracks


def probe_duration(path: Path) -> float | None:
    if not shutil.which("ffprobe"):
        return None
    try:
        result = subprocess.run(
            [
                "ffprobe",
                "-v",
                "error",
                "-show_entries",
                "format=duration",
                "-of",
                "default=noprint_wrappers=1:nokey=1",
                str(path),
            ],
            text=True,
            capture_output=True,
            timeout=2.5,
            check=False,
        )
        return float(result.stdout.strip())
    except (ValueError, subprocess.TimeoutExpired, OSError):
        return None


def format_time(seconds: float | None) -> str:
    if seconds is None or seconds < 0:
        return "--:--"
    seconds = int(seconds)
    return f"{seconds // 60}:{seconds % 60:02d}"


def fit(text: str, width: int) -> str:
    if width <= 0:
        return ""
    return text[: max(0, width - 1)] + "…" if len(text) > width else text.ljust(width)


def clean_filename(name: str) -> str:
    cleaned = name.strip().replace("/", "-").replace("\0", "")
    return " ".join(cleaned.split())


def rename_track(track: Track, new_name: str) -> tuple[bool, str, Track | None]:
    cleaned = clean_filename(new_name)
    if not cleaned:
        return False, "Имя не может быть пустым.", None

    candidate = Path(cleaned)
    if candidate.suffix.lower() in SUPPORTED_EXTS:
        new_path = track.path.with_name(candidate.name)
    else:
        new_path = track.path.with_name(cleaned + track.path.suffix)

    if new_path == track.path:
        return False, "Имя не изменилось.", None
    if new_path.exists():
        return False, "Файл с таким именем уже существует.", None

    try:
        track.path.rename(new_path)
    except OSError as exc:
        return False, f"Не удалось переименовать: {exc.strerror or exc}", None

    return True, f"Переименовано: {new_path.name}", Track(path=new_path, title=new_path.stem, duration=track.duration)


def delete_track(track: Track) -> tuple[bool, str]:
    try:
        track.path.unlink()
    except OSError as exc:
        return False, f"Не удалось удалить: {exc.strerror or exc}"
    return True, f"Удалено: {track.path.name}"


def next_track_index(current: int | None, selected: int, count: int, playback_mode: str) -> int:
    if count <= 0:
        return 0
    base = current if current is not None else selected
    if playback_mode == MIX_MODE and count > 1:
        choices = [idx for idx in range(count) if idx != base]
        return SHUFFLER.choice(choices)
    return (base + 1) % count


def previous_track_index(current: int | None, selected: int, count: int) -> int:
    if count <= 0:
        return 0
    base = current if current is not None else selected
    return (base - 1) % count


def safe_add(win: curses.window, y: int, x: int, text: str, attr: int = 0) -> None:
    max_y, max_x = win.getmaxyx()
    if y < 0 or y >= max_y or x < 0 or x >= max_x:
        return
    clipped_width = max_x - x
    try:
        win.addnstr(y, x, text, clipped_width, attr)
    except curses.error:
        pass


def init_colors() -> None:
    if not curses.has_colors():
        return
    curses.start_color()
    default_bg = -1
    try:
        curses.use_default_colors()
    except curses.error:
        default_bg = curses.COLOR_BLACK
    pairs = [
        (1, curses.COLOR_CYAN, default_bg),
        (2, curses.COLOR_WHITE, curses.COLOR_BLUE),
        (3, curses.COLOR_MAGENTA, default_bg),
        (4, curses.COLOR_CYAN, default_bg),
        (5, curses.COLOR_GREEN, default_bg),
        (6, curses.COLOR_YELLOW, default_bg),
        (7, curses.COLOR_BLUE, default_bg),
    ]
    for pair_id, fg, bg in pairs:
        try:
            curses.init_pair(pair_id, fg, bg)
        except curses.error:
            pass


def draw_frame(stdscr: curses.window, y: int, x: int, h: int, w: int, title: str = "") -> None:
    if h < 2 or w < 2:
        return
    safe_add(stdscr, y, x, "╭" + "─" * (w - 2) + "╮", curses.color_pair(7))
    for row in range(y + 1, y + h - 1):
        safe_add(stdscr, row, x, "│", curses.color_pair(7))
        safe_add(stdscr, row, x + w - 1, "│", curses.color_pair(7))
    safe_add(stdscr, y + h - 1, x, "╰" + "─" * (w - 2) + "╯", curses.color_pair(7))
    if title:
        safe_add(stdscr, y, x + 2, f" {title} ", curses.color_pair(1) | curses.A_BOLD)


def draw_playlist(stdscr: curses.window, tracks: list[Track], selected: int, current: int | None, h: int, w: int) -> None:
    draw_frame(stdscr, 2, 0, h - 5, w, " ~/Music ")
    inner_h = h - 7
    if not tracks:
        safe_add(stdscr, 5, 3, "Музыка не найдена. Положи mp3/flac/wav/ogg/m4a в ~/Music.", curses.color_pair(6))
        return

    selected = max(0, min(selected, len(tracks) - 1))
    offset = max(0, selected - inner_h // 2)
    offset = min(offset, max(0, len(tracks) - inner_h))
    for row in range(inner_h):
        idx = offset + row
        if idx >= len(tracks):
            break
        marker = "▶" if idx == current else " "
        prefix = f"{marker} {idx + 1:02d}. "
        text = prefix + tracks[idx].title
        attr = curses.color_pair(2) | curses.A_BOLD if idx == selected else curses.color_pair(1 if idx == current else 0)
        safe_add(stdscr, 3 + row, 2, fit(text, w - 4), attr)


def draw_status(
    stdscr: curses.window,
    backend: AudioBackend,
    track: Track | None,
    h: int,
    w: int,
    message: str,
    playback_mode: str,
    animation_mode: str,
) -> None:
    elapsed = backend.elapsed()
    duration = track.duration if track else None
    if duration is None and track and backend.is_playing():
        duration = track.duration = probe_duration(track.path)

    if track:
        progress = min(1.0, elapsed / duration) if duration and duration > 0 else 0.0
        bar_w = max(10, w - 36)
        filled = int(bar_w * progress)
        bar = "█" * filled + "░" * (bar_w - filled)
        state = "PAUSE" if backend.paused_at is not None else "PLAY"
        line = f"{state}  {format_time(elapsed)} / {format_time(duration)}  {bar}"
    else:
        line = "STOP  --:-- / --:--"

    line = f"{line}  MODE:{playback_mode.upper()}  ANIM:{animation_mode.upper()}"
    safe_add(stdscr, h - 3, 1, fit(line, w - 2), curses.color_pair(6) | curses.A_BOLD)
    controls = "Enter play  Space pause  E edit  M mode  n/b next/prev  s stop  r rescan  q quit"
    safe_add(stdscr, h - 2, 1, fit(controls, w - 2), curses.color_pair(1))
    if message:
        safe_add(stdscr, h - 1, 1, fit(message, w - 2), curses.color_pair(3) | curses.A_BOLD)


def draw_modal(stdscr: curses.window, h: int, w: int, title: str, lines: list[str]) -> None:
    box_w = min(max(44, max((len(line) for line in lines), default=0) + 6), w - 4)
    box_h = min(len(lines) + 4, h - 4)
    y = max(1, (h - box_h) // 2)
    x = max(2, (w - box_w) // 2)
    modal = curses.newwin(box_h, box_w, y, x)
    modal.bkgd(" ", curses.color_pair(0))
    modal.erase()
    draw_frame(modal, 0, 0, box_h, box_w, f" {title} ")
    for idx, line in enumerate(lines[: box_h - 3]):
        safe_add(modal, 2 + idx, 3, fit(line, box_w - 6), curses.color_pair(1) | curses.A_BOLD)
    modal.noutrefresh()


def handle_edit_key(
    key: int,
    mode: str | None,
    rename_text: str,
    tracks: list[Track],
    selected: int,
    current: int | None,
    backend: AudioBackend,
    visualizer: Visualizer,
) -> tuple[str | None, str, list[Track], int, int | None, str]:
    message = ""
    if mode == EDIT_MENU:
        if key in (ord("q"), 27, ord("e"), ord("E")):
            return None, rename_text, tracks, selected, current, ""
        if key in (ord("r"), ord("R")) and tracks:
            return RENAME_MODE, tracks[selected].title, tracks, selected, current, ""
        if key in (ord("d"), ord("D")) and tracks:
            return DELETE_CONFIRM, rename_text, tracks, selected, current, ""
        return mode, rename_text, tracks, selected, current, ""

    if mode == RENAME_MODE:
        if key == 27:
            return EDIT_MENU, "", tracks, selected, current, "Переименование отменено."
        if key in (10, 13, curses.KEY_ENTER):
            old_track = tracks[selected]
            was_current = current == selected
            current_path = tracks[current].path if current is not None and current < len(tracks) else None
            if was_current:
                backend.stop()
                current = None
            ok, message, new_track = rename_track(old_track, rename_text)
            if ok and new_track:
                tracks[selected] = new_track
                tracks.sort(key=lambda item: str(item.path).casefold())
                selected = next((idx for idx, item in enumerate(tracks) if item.path == new_track.path), selected)
                if was_current:
                    current = selected
                    visualizer.reseed(tracks[current])
                    backend.play(tracks[current])
                elif current_path is not None:
                    current = next((idx for idx, item in enumerate(tracks) if item.path == current_path), current)
            return None, "", tracks, selected, current, message
        if key in (curses.KEY_BACKSPACE, 127, 8):
            return mode, rename_text[:-1], tracks, selected, current, ""
        if 32 <= key <= 126 and len(rename_text) < 120:
            return mode, rename_text + chr(key), tracks, selected, current, ""
        return mode, rename_text, tracks, selected, current, ""

    if mode == DELETE_CONFIRM:
        if key in (ord("q"), 27, ord("n"), ord("N")):
            return EDIT_MENU, rename_text, tracks, selected, current, "Удаление отменено."
        if key in (ord("y"), ord("Y")) and tracks:
            deleting_current = current == selected
            if deleting_current:
                backend.stop()
                current = None
            old_path = tracks[selected].path
            ok, message = delete_track(tracks[selected])
            if ok:
                tracks = [track for track in tracks if track.path != old_path]
                selected = min(selected, max(0, len(tracks) - 1))
                if current is not None and current > selected:
                    current -= 1
            return None, "", tracks, selected, current, message
        return mode, rename_text, tracks, selected, current, ""

    return mode, rename_text, tracks, selected, current, ""


def run(stdscr: curses.window) -> None:
    try:
        curses.curs_set(0)
    except curses.error:
        pass
    curses.noecho()
    curses.cbreak()
    stdscr.nodelay(True)
    stdscr.keypad(True)
    init_colors()

    tracks = scan_music()
    selected = 0
    current: int | None = None
    backend = AudioBackend()
    visualizer = Visualizer()
    message = "" if backend.backend else "Не найден аудио-бэкенд: установи ffplay/mpv/vlc/mpg123."
    last_tick = 0.0
    ui_mode: str | None = None
    playback_mode = NORMAL_MODE
    animation_mode = PULSE_ANIMATION
    rename_text = ""

    try:
        while True:
            now = time.monotonic()
            if now - last_tick < 1 / 24:
                time.sleep(0.008)
                continue
            last_tick = now

            if backend.finished() and current is not None and tracks:
                current = next_track_index(current, selected, len(tracks), playback_mode)
                selected = current
                visualizer.reseed(tracks[current])
                backend.play(tracks[current])

            key = stdscr.getch()
            if key != -1:
                if ui_mode == MODE_MENU:
                    if key in (ord("q"), 27, ord("m"), ord("M")):
                        ui_mode = None
                    elif key in (ord("1"), ord("n"), ord("N")):
                        playback_mode = NORMAL_MODE
                        ui_mode = None
                        message = "Mode: normal."
                    elif key in (ord("2"), ord("x"), ord("X")):
                        playback_mode = MIX_MODE
                        ui_mode = None
                        message = "Mode: mix. Следующие треки будут случайными."
                    elif key in (ord("3"), ord("a"), ord("A")):
                        ui_mode = ANIMATION_MENU
                elif ui_mode == ANIMATION_MENU:
                    if key in (ord("q"), 27):
                        ui_mode = MODE_MENU
                    elif key in (ord("1"), ord("p"), ord("P")):
                        animation_mode = PULSE_ANIMATION
                        visualizer.reseed(tracks[current] if current is not None and tracks else None)
                        ui_mode = MODE_MENU
                        message = "Animation: pulse."
                    elif key in (ord("2"), ord("w"), ord("W")):
                        animation_mode = WAVE_ANIMATION
                        visualizer.reseed(tracks[current] if current is not None and tracks else None)
                        ui_mode = MODE_MENU
                        message = "Animation: wave."
                    elif key in (ord("3"), ord("r"), ord("R")):
                        animation_mode = RAIN_ANIMATION
                        visualizer.reseed(tracks[current] if current is not None and tracks else None)
                        ui_mode = MODE_MENU
                        message = "Animation: rain."
                elif ui_mode:
                    ui_mode, rename_text, tracks, selected, current, edit_message = handle_edit_key(
                        key,
                        ui_mode,
                        rename_text,
                        tracks,
                        selected,
                        current,
                        backend,
                        visualizer,
                    )
                    if edit_message:
                        message = edit_message
                elif key in (ord("q"), 27):
                    break
                elif key in (curses.KEY_UP, ord("k")) and tracks:
                    selected = (selected - 1) % len(tracks)
                elif key in (curses.KEY_DOWN, ord("j")) and tracks:
                    selected = (selected + 1) % len(tracks)
                elif key in (curses.KEY_NPAGE,):
                    selected = min(len(tracks) - 1, selected + 8)
                elif key in (curses.KEY_PPAGE,):
                    selected = max(0, selected - 8)
                elif key in (10, 13, curses.KEY_ENTER) and tracks:
                    current = selected
                    visualizer.reseed(tracks[current])
                    backend.play(tracks[current])
                    message = f"Играет через {backend.backend}: {tracks[current].title}" if backend.backend else message
                elif key == ord(" "):
                    backend.toggle_pause()
                elif key == ord("s"):
                    backend.stop()
                    current = None
                    message = "Остановлено."
                elif key == ord("n") and tracks:
                    current = selected = next_track_index(current, selected, len(tracks), playback_mode)
                    visualizer.reseed(tracks[current])
                    backend.play(tracks[current])
                elif key == ord("b") and tracks:
                    current = selected = previous_track_index(current, selected, len(tracks))
                    visualizer.reseed(tracks[current])
                    backend.play(tracks[current])
                elif key == ord("r"):
                    tracks = scan_music()
                    selected = min(selected, max(0, len(tracks) - 1))
                    current = None
                    backend.stop()
                    message = f"Обновлено: {len(tracks)} треков."
                elif key in (ord("e"), ord("E")) and tracks:
                    ui_mode = EDIT_MENU
                    rename_text = ""
                elif key in (ord("m"), ord("M")):
                    ui_mode = MODE_MENU

            h, w = stdscr.getmaxyx()
            stdscr.erase()
            if h < 18 or w < 64:
                safe_add(stdscr, 1, 2, "Увеличь терминал хотя бы до 64x18.", curses.color_pair(6) | curses.A_BOLD)
                stdscr.refresh()
                continue

            title = "TERMINAL PLAYER"
            safe_add(stdscr, 0, 2, title, curses.color_pair(3) | curses.A_BOLD)
            safe_add(stdscr, 0, w - 21, time.strftime("%H:%M:%S"), curses.color_pair(1))

            left_w = max(30, min(48, w // 2 - 2))
            right_x = left_w + 1
            right_w = w - right_x
            draw_playlist(stdscr, tracks, selected, current, h, left_w)
            draw_frame(stdscr, 2, right_x, h - 5, right_w, " pulse field ")
            visualizer.draw(
                stdscr,
                3,
                right_x + 1,
                h - 7,
                right_w - 2,
                backend.is_playing() and backend.paused_at is None,
                animation_mode,
            )

            track = tracks[current] if current is not None and current < len(tracks) else None
            if track:
                artist_line = fit(track.path.relative_to(MUSIC_DIR).as_posix(), right_w - 4)
                safe_add(stdscr, 3, right_x + 2, artist_line, curses.color_pair(1) | curses.A_BOLD)
            draw_status(stdscr, backend, track, h, w, message, playback_mode, animation_mode)
            stdscr.noutrefresh()
            if ui_mode == EDIT_MENU and tracks:
                draw_modal(
                    stdscr,
                    h,
                    w,
                    " Edit track ",
                    [
                        tracks[selected].title,
                        "",
                        "r  rename file",
                        "d  delete file",
                        "Esc/q  close",
                    ],
                )
            elif ui_mode == RENAME_MODE and tracks:
                draw_modal(
                    stdscr,
                    h,
                    w,
                    " Rename ",
                    [
                        "New file name:",
                        rename_text + "█",
                        "",
                        "Enter  save    Esc  cancel",
                    ],
                )
            elif ui_mode == DELETE_CONFIRM and tracks:
                draw_modal(
                    stdscr,
                    h,
                    w,
                    " Delete ",
                    [
                        f"Delete this file?",
                        tracks[selected].path.name,
                        "",
                        "y  delete    n/Esc  cancel",
                    ],
                )
            elif ui_mode == MODE_MENU:
                normal_mark = ">" if playback_mode == NORMAL_MODE else " "
                mix_mark = ">" if playback_mode == MIX_MODE else " "
                draw_modal(
                    stdscr,
                    h,
                    w,
                    " Mode ",
                    [
                        f"{normal_mark} 1 / n  normal - по порядку",
                        f"{mix_mark} 2 / x  mix    - случайный следующий трек",
                        f"  3 / a  animation - {animation_mode}",
                        "",
                        "Esc/q/M  close",
                    ],
                )
            elif ui_mode == ANIMATION_MENU:
                pulse_mark = ">" if animation_mode == PULSE_ANIMATION else " "
                wave_mark = ">" if animation_mode == WAVE_ANIMATION else " "
                rain_mark = ">" if animation_mode == RAIN_ANIMATION else " "
                draw_modal(
                    stdscr,
                    h,
                    w,
                    " Animation ",
                    [
                        f"{pulse_mark} 1 / p  pulse - частицы и кольца",
                        f"{wave_mark} 2 / w  wave  - волны и спектр",
                        f"{rain_mark} 3 / r  rain  - энергетический дождь",
                        "",
                        "Esc/q  back",
                    ],
                )
            curses.doupdate()
    finally:
        backend.stop()


def main() -> None:
    curses.wrapper(run)


if __name__ == "__main__":
    main()
